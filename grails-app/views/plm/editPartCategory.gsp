<!doctype html><html><head><g:render template="theme"/></head><body><div class="mat-page"><g:render template="header" model="[pageTitle:'Edit Category']"/><section class="mat-card"><div class="mat-card-body"><g:form action="savePartCategory" id="${part.id}" method="POST"><div class="mat-field"><label>Document Category</label><select name="documentCategory"><option value="">None</option><g:each in="${categories}" var="c"><option value="${c.id}" ${part.documentCategory?.id==c.id?'selected':''}>${c.toString().encodeAsHTML()}</option></g:each></select></div><button class="mat-btn mat-btn-primary">Save</button> <g:link action="showPart" id="${part.id}" class="mat-btn">Cancel</g:link></g:form></div></section></div></body></html>