<!doctype html><html><head><g:render template="theme"/></head><body><div class="mat-page"><g:render template="header" model="[pageTitle:'Edit Comment']"/><section class="mat-card"><div class="mat-card-body"><g:form action="saveComment" id="${part.id}" method="POST"><div class="mat-field"><label>Comment</label><textarea name="comment" rows="12">${part.comment?.encodeAsHTML()}</textarea></div><button class="mat-btn mat-btn-primary">Save</button> <g:link action="showPart" id="${part.id}" class="mat-btn">Cancel</g:link></g:form></div></section></div></body></html>