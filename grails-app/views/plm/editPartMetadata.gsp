<!doctype html><html><head><title>Edit Part Metadata</title><g:render template="theme"/></head><body><div class="mat-page"><g:render template="header" model="[pageTitle:'Edit Part Metadata']"/><section class="mat-card"><div class="mat-card-head"><h2>${part.label?.encodeAsHTML()}</h2></div><div class="mat-card-body"><form action="${request.contextPath}/plm/savePartMetadata/${part.id}" method="post"><div class="plm-grid"><div><g:each in="${['description1','description2','description3','supplier','surfaceTreatment','dcn']}" var="field"><div class="mat-field"><label>${field}</label><input type="text" name="${field}" value="${part[field]?.toString()?.encodeAsHTML()}"/></div></g:each></div><div><g:if test="${materialLibraryInstalled}"><div class="mat-field"><label>Material Category</label><select id="materialCategory"><option value="">Select category</option><g:each in="${categories}" var="c"><option value="${c.id}">${c.name?.toString()?.encodeAsHTML()}</option></g:each></select></div><div class="mat-field"><label>Material</label><select id="material" name="material"><option value="">Select material</option><g:each in="${materials}" var="m"><option value="${m.name?.toString()?.encodeAsHTML()}" data-category="${m.category_id}" ${m.name?.toString()?.equalsIgnoreCase(part.material ?: '') ? 'selected' : ''}>${m.name?.toString()?.encodeAsHTML()}</option></g:each></select></div></g:if><g:else><div class="mat-field"><label>Material</label><input name="material" value="${part.material?.encodeAsHTML()}"/></div></g:else><div class="mat-field"><label>Cost</label><input name="cost" type="number" step="0.0001" min="0" value="${part.cost ?: ''}"/></div><div class="mat-field"><label>Weight</label><input name="weight" type="number" step="0.0001" min="0" value="${part.weight ?: ''}"/></div><div class="mat-field"><label>LOM</label><select name="lom"><option value="">—</option><g:each in="${['A','B','C','P']}" var="v"><option value="${v}" ${part.lom?.toString()==v?'selected':''}>${v}</option></g:each></select></div></div></div><div class="mat-actions"><button class="mat-btn mat-btn-primary">Save</button><g:link action="showPart" id="${part.id}" class="mat-btn">Cancel</g:link></div></form></div></section></div><script>(function(){var cat=document.getElementById('materialCategory'),sel=document.getElementById('material');if(!cat||!sel)return;var options=Array.from(sel.options);var chosen=sel.selectedOptions[0];if(chosen&&chosen.dataset.category)cat.value=chosen.dataset.category;function filter(){options.forEach(function(o){o.hidden=!!o.dataset.category&&o.dataset.category!==cat.value});if(sel.selectedOptions.length&&sel.selectedOptions[0].hidden)sel.value='';}cat.addEventListener('change',filter);filter();})();</script></body></html>